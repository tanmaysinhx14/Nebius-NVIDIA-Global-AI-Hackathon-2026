# Required: create a key in Nebius Token Factory.
# Keep real values in .env.local; never expose them in browser code or git.
NEBIUS_API_KEY=

# Required for the grounded analysis flow; receives only a redacted error signature.
TAVILY_API_KEY=

# Confirm model IDs against the models enabled for your Token Factory account.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEMOTRON_NANO_MODEL=
NEMOTRON_SUPER_MODEL=
NEMOTRON_ULTRA_MODEL=

# Enable only when every selected model has the JSON mode tag in the Token Factory catalog.
NEBIUS_JSON_MODE=false

# Shared daily demo limit across visitors in production; local fallback is process-wide.
TRACEKIT_DAILY_ANALYSIS_LIMIT=50

# Required in production: shared rate limits (8 analysis / 20 model-list requests per IP per minute
# plus the global daily analysis cap above).
# In local development, the app uses a per-process fallback when these are blank.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
